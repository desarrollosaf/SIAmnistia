# Etapa de compilación
FROM node:24-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

# Etapa de producción
FROM node:24-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

# Chromium del sistema para puppeteer-core (genera el acuse y la información complementaria
# como HTML/CSS renderizado a PDF). No se usa el Chromium que puppeteer descarga por su cuenta
# porque esa descarga no funciona bien en Alpine (musl libc).
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY package*.json ./

# Se instalan tambien las devDependencies porque sequelize-cli (migrate/seed)
# se ejecuta dentro de este contenedor via "docker compose exec backend npm run migrate".
RUN npm ci --include=dev

COPY --from=build /app/dist ./dist

# sequelize-cli no lee dist/: .sequelizerc resuelve migrations/seeders/models
# relativos a src/database, asi que ese codigo fuente viaja tal cual.
COPY --from=build /app/src/database ./src/database
COPY --from=build /app/.sequelizerc ./.sequelizerc

RUN mkdir -p /app/uploads

EXPOSE 3050

CMD ["node", "dist/main.js"]
