# Plantilla de configuracion. Copiala a .env y captura los valores reales:
#     cp backend/.env.example backend/.env
# El archivo .env no se versiona: trae las credenciales del servidor.
# Si un valor lleva "#" o espacios, escríbelo entre comillas: DB_PASSWORD="abc#123"
# (sin comillas, todo lo que sigue al "#" se toma como comentario).

PORT=3050

# ---------------------------------------------------------------------
# Base de datos del sistema de amnistía (MySQL / MariaDB).
#
# DB_HOST segun donde este el servidor:
#   host.docker.internal  MySQL en esta misma maquina y el backend en Docker
#   localhost              MySQL en esta misma maquina y el backend con npm
#   10.0.0.25 / mysql.interno   servidor de red (pon su IP o su nombre)
# ---------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Secreto de firma del token. Generalo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# URL pública del frontend (sin diagonal final). Se usa en las ligas de los correos
# y en el código QR del acuse, p. ej. https://servidor/amnistia
APP_URL=http://localhost:4200

# ---------------------------------------------------------------------
# Correo saliente (SMTP): acuses, turnos a instituciones y tokens de consulta.
# Si MAIL_HOST se deja vacío los correos no se envían (solo se registran en el log).
# ---------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Sistema de Amnistía <amnistia@legislativoedomex.gob.mx>"

# Contraseña del usuario ROOT que crea la migración inicial (solo si la tabla users está vacía).
ROOT_PASSWORD=
